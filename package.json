{
  "name": "vyper-landing-cn",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "next-sitemap --config next-sitemap.config.cjs",
    "sitemap": "next-sitemap --config next-sitemap.config.cjs",
    "start": "next start",
    "pages:dev": "pnpm run pages:build && wrangler pages dev",
    "pages:build": "pnpx @cloudflare/next-on-pages",
    "pages:deploy": "pnpm run pages:build && wrangler pages deploy",
    "typecheck": "tsc",
    "lint": "biome check --max-diagnostics=100 .",
    "lint:fix": "biome check --max-diagnostics=100 --write .",
    "prepare": "husky",
    "commit": "git-cz",
    "qwer": "git-cz"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.2.10",
    "@radix-ui/react-dropdown-menu": "^2.1.19",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-slot": "^1.3.0",
    "@tailwindcss/postcss": "^4.3.2",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-query-devtools": "^5.101.2",
    "@types/mdx": "^2.0.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "immer": "^11.1.9",
    "jotai": "^2.20.1",
    "ky": "^2.0.2",
    "lucide-react": "^1.23.0",
    "motion": "^12.42.2",
    "next": "16.2.10",
    "next-sitemap": "^4.2.3",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.16",
    "radix-ui": "^1.6.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.3.0",
    "simple-icons": "^16.24.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "ts-enum-util": "^4.1.0",
    "uni-string": "^2.0.7",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.2",
    "commitizen": "^4.3.2",
    "cz-git": "^1.13.1",
    "czg": "^1.13.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "packageManager": "pnpm@9.13.2"
